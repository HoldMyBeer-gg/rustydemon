{
  "name": "wowf-end-to-end",
  "covers": "One pass through the whole app on a WoW Forever archive: open the install with a listfile, browse the tree to a file, preview text, glob-search for a model and see it in the 3D viewport, search a texture by full path and preview it, extract that texture to disk and check its bytes, then open and close the Help menu.",
  "platforms": [
    "linux",
    "windows"
  ],
  "verified": {
    "linux": "2026-11-12"
  },
  "phases": [
    {
      "name": "archive and listfile load",
      "note": "Opening the archive and building the tree takes 15 to 20 seconds on a Steam Deck.",
      "learn": {},
      "steps": [
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "Expand interface",
          "timeout": 120
        }
      ],
      "checks": [
        {
          "present": {
            "name": "creature"
          }
        },
        {
          "present": {
            "name": "sound"
          }
        }
      ]
    },
    {
      "name": "expand interface",
      "learn": {
        "expand_interface": {
          "name": "Expand interface"
        }
      },
      "steps": [
        {
          "action": "click",
          "target": "expand_interface"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "Expand addons",
          "timeout": 10
        }
      ]
    },
    {
      "name": "expand addons",
      "learn": {
        "expand_addons": {
          "name": "Expand addons"
        }
      },
      "steps": [
        {
          "action": "click",
          "target": "expand_addons"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "blizzard_gamepad",
          "timeout": 10
        }
      ]
    },
    {
      "name": "browse a folder",
      "learn": {
        "gamepad": {
          "name": "blizzard_gamepad"
        }
      },
      "steps": [
        {
          "action": "click",
          "target": "gamepad"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "blizzard_gamepad.toc",
          "timeout": 10
        }
      ],
      "checks": [
        {
          "present": {
            "name": "Export Folder"
          }
        }
      ]
    },
    {
      "name": "text preview",
      "learn": {
        "toc": {
          "name": "blizzard_gamepad.toc"
        }
      },
      "steps": [
        {
          "action": "click",
          "target": "toc"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "Export Raw",
          "timeout": 20
        }
      ]
    },
    {
      "name": "glob search for a model",
      "learn": {
        "query": {
          "role": {
            "windows": "textfield",
            "linux": "entry"
          }
        },
        "search": {
          "name": "Search"
        }
      },
      "steps": [
        {
          "action": "type",
          "target": "query",
          "text": "*sylvanas*.m2"
        },
        {
          "action": "click",
          "target": "search"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "sylvanas.m2",
          "timeout": 20
        }
      ],
      "checks": [
        {
          "present": {
            "name": "ladysylvanaswindrunner.m2"
          }
        }
      ]
    },
    {
      "name": "model preview",
      "learn": {
        "hit": {
          "name": "sylvanas.m2"
        }
      },
      "steps": [
        {
          "action": "click",
          "target": "hit"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "Export As OBJ",
          "timeout": 20
        }
      ],
      "checks": [
        {
          "present": {
            "name": "3D preview: drag to rotate, Shift+drag to pan, scroll to zoom"
          }
        }
      ]
    },
    {
      "name": "search a texture by path",
      "learn": {
        "query": {
          "role": {
            "windows": "textfield",
            "linux": "entry"
          }
        },
        "search": {
          "name": "Search"
        }
      },
      "steps": [
        {
          "action": "type",
          "target": "query",
          "text": "interface/icons/inv_misc_questionmark.blp"
        },
        {
          "action": "click",
          "target": "search"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "inv_misc_questionmark.blp",
          "timeout": 20
        }
      ]
    },
    {
      "name": "texture preview",
      "learn": {
        "hit": {
          "name": "inv_misc_questionmark.blp"
        }
      },
      "steps": [
        {
          "action": "click",
          "target": "hit"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "Export As PNG",
          "timeout": 20
        }
      ]
    },
    {
      "name": "extract the texture to disk",
      "only": [
        "linux"
      ],
      "note": "The Export buttons open a native folder dialog, which is not scripted, so the same file goes through rustydemon-cli and its first four bytes are checked. POSIX shell, so Linux only for now.",
      "learn": {},
      "steps": [
        {
          "action": "shell",
          "cmd": "\"$RUSTYDEMON_CLI\" export -a \"$WOW_DIR\" -l \"$WOW_LISTFILE\" -p interface/icons/inv_misc_questionmark.blp -o \"$SMOKE/out\" && test \"$(head -c 4 \"$SMOKE/out/interface/icons/inv_misc_questionmark.blp\")\" = BLP2"
        }
      ]
    },
    {
      "name": "help menu opens",
      "learn": {
        "help": {
          "name": "Help"
        }
      },
      "steps": [
        {
          "action": "click",
          "target": "help"
        },
        {
          "action": "wait_for_element",
          "window_id": "$WINDOW",
          "name": "About",
          "timeout": 5
        }
      ]
    },
    {
      "name": "help menu closes",
      "note": "Clicking Help again toggles the menu shut. The About window itself is not scripted: it is a separate egui viewport, and only the main window publishes an accessibility tree, so nothing in it can be found or clicked.",
      "learn": {
        "help": {
          "name": "Help"
        }
      },
      "steps": [
        {
          "action": "click",
          "target": "help"
        },
        {
          "action": "sleep",
          "seconds": 0.3
        }
      ],
      "checks": [
        {
          "present": {
            "name": "Search"
          }
        },
        {
          "absent": {
            "name": "About"
          }
        }
      ]
    }
  ],
  "checks": [
    {
      "windows": 1
    }
  ],
  "notes": "Requires a World of Warcraft install with the WoW Forever product (wowf) and a current community listfile, both on the app's command line, plus RUSTYDEMON_CLI, WOW_DIR and WOW_LISTFILE in the environment for the extraction phase. See smoke/README.md. On Linux the app must run under XWayland (env -u WAYLAND_DISPLAY in the config), because typed text does not reach the search box on native Wayland. Linux run 2026-11-12 (SteamOS, KDE Wayland session, app on XWayland, wowf 1.60.1.70888, bad-ass-mcp 1.6.1.dev37) passed in 1 minute 14 seconds. The Windows roles and steps are written from sylvanas-spin, which passed there; this script has not been run on Windows. The extraction phase is Linux only."
}
