# Maintainer: jabberwock <88205+jabberwock@users.noreply.github.com>

pkgname=rustydemon-bin
pkgver=0.7.0
pkgrel=1
pkgdesc="CASC archive explorer for Blizzard games (prebuilt binary)"
arch=('x86_64')
url="https://github.com/HoldMyBeer-gg/rustydemon"
license=('LicenseRef-AGPL-3.0-or-later-with-Commons-Clause')
depends=(
  'glibc'
  'gcc-libs'
  'libxkbcommon'
  'wayland'
  'libx11'
  'libxcursor'
  'libxi'
  'libxrandr'
  'vulkan-icd-loader'
  'xdg-desktop-portal'
  'hicolor-icon-theme'
)
optdepends=(
  'vulkan-driver: hardware rendering'
  'xdg-desktop-portal-impl: file and folder dialogs'
)
provides=('rustydemon')
conflicts=('rustydemon')
options=('!strip' '!debug')

_raw="https://raw.githubusercontent.com/HoldMyBeer-gg/rustydemon/v${pkgver}"
source=(
  "${url}/releases/download/v${pkgver}/rustydemon-${pkgver}-x86_64-unknown-linux-gnu.tar.gz"
  "rustydemon-${pkgver}-LICENSE::${_raw}/LICENSE"
  "rustydemon-${pkgver}-48.png::${_raw}/assets/icons/linux/icon_48.png"
  "rustydemon-${pkgver}-128.png::${_raw}/assets/icons/linux/icon_128.png"
  "rustydemon-${pkgver}-256.png::${_raw}/assets/icons/linux/icon_256.png"
  "rustydemon-${pkgver}-512.png::${_raw}/assets/icons/linux/icon_512.png"
  "rustydemon.desktop"
)
sha256sums=(
  'cafad58f4613bd56360b1f7f64631153ed198926378d19ae09a8428c0825ee29'
  '745e94775f5c3d7b373299731ea6dfacf8457968870a8dfe04b7f1624b9d61c0'
  '6d21767828bf7c903d86434a9e5df4ccca18fb115cb15a0245955f7def193baa'
  '0b180da07e553036757e5ac4f386218b608f0f830066ba0d40b45b5dd8c59ab3'
  'e4fd2bd99c23a6d07cbf19b22da8ea4230d5dcd1b69dfed400d605182a7eb9d8'
  '49a923a9bccb4a528b5ce76485db02e11c45f8cd5229327bec3472b9eba9e7a8'
  '146350847108fa2b2b77f7897978308223fe485d4f771df0f5f35cbd0a8c0692'
)

package() {
  install -Dm755 rustydemon "${pkgdir}/usr/bin/rustydemon"
  install -Dm644 rustydemon.desktop "${pkgdir}/usr/share/applications/rustydemon.desktop"
  install -Dm644 "rustydemon-${pkgver}-LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  local size
  for size in 48 128 256 512; do
    install -Dm644 "rustydemon-${pkgver}-${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/rustydemon.png"
  done
}
